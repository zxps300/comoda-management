# ==============================================================================
# Nginx Reverse Proxy Configuration for Comoda Restaurant Management System
# Place this in /etc/nginx/sites-available/comoda.conf and link to sites-enabled/
# ==============================================================================

# 1. Rate Limiting Zones (DDoS and Brute Force mitigation)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;

# 2. Redirect all plain HTTP traffic to HTTPS (Port 80 -> 443)
server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com 192.168.1.100; # Replace with your LAN IP or Domain

    # Redirect all HTTP requests to HTTPS with a 301 Permanent Redirect
    return 301 https://$host$request_uri;
}

# 3. Main HTTPS SSL Server Block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yourdomain.com 192.168.1.100;

    # SSL Certificates (Use Let's Encrypt / Certbot or Self-Signed for Local LAN)
    ssl_certificate /etc/ssl/certs/comoda.crt;
    ssl_certificate_key /etc/ssl/private/comoda.key;

    # Strong SSL Protocol & Cipher Suites
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security Headers (Defense in Depth)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # Client Max Body Size (e.g. for receipt photo uploads)
    client_max_body_size 10M;

    # Root for Frontend SPA
    root /var/www/comoda/frontend/dist;
    index index.html;

    # Route Frontend Single Page Application
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API Requests to Laravel Backend (Running on port 8000)
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # Forward Client Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
    }

    # Strict Rate Limit for Auth Login Endpoint
    location /api/auth/login {
        limit_req zone=login_limit burst=5 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Public Digital Menu Static / QR Menu Assets
    location /menu.html {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
}
